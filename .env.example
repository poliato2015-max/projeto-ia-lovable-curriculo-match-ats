# Supabase (já existente)
SUPABASE_PROJECT_ID="your-project-id"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"
SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"
VITE_SUPABASE_URL="https://your-project.supabase.co"

# =============================================================================
# LLM Provider Configuration (Feature 002: Segurança API Key + Migração Provedor)
# =============================================================================
# Provedor ativo: lovable | nvidia | openai | openrouter | groq | together | ollama | anthropic
LLM_PROVIDER=lovable

# API Key do provedor ativo (substitui LOVABLE_API_KEY quando LLM_PROVIDER != lovable)
# LLM_API_KEY=

# Modelo a usar (deve ser válido para o provedor escolhido)
# Exemplos:
#   lovable:      google/gemini-2.5-flash (fixo no gateway)
#   nvidia:       nvidia/nemotron-3-ultra | nvidia/llama-3.1-nemotron-70b-instruct | nvidia/nemotron-3-8b
#   openai:       gpt-4o | gpt-4o-mini
#   openrouter:   openai/gpt-4o-mini | anthropic/claude-3.5-sonnet
#   groq:         llama-3.1-70b-versatile
#   together:     meta-llama/Meta-Llama-3.1-70B-Instruct-Turbo
#   ollama:       llama3.1:70b (local)
#   anthropic:    claude-3-5-sonnet (requer AnthropicClient dedicado)
# LLM_MODEL=

# Base URL customizada (opcional) - útil para self-hosted NIM, Ollama, vLLM
# LLM_BASE_URL=

# Organization ID (opcional) - OpenAI, Anthropic
# LLM_ORG_ID=

# Timeout da chamada LLM em milissegundos (default: 60000)
# LLM_TIMEOUT_MS=60000

# =============================================================================
# Lovable AI Gateway (Legacy - mantido para retrocompatibilidade e rollback)
# =============================================================================
# Injetada automaticamente pelo ambiente Lovable/Vercel
# LOVABLE_API_KEY=